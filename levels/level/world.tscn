[node name="TextBox" parent="CSGBox3D6" unique_id=1116978235 instance=ExtResource("6_ujtx7")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -7, 0, 9)
description = "Este año de la clase de español era muy bueno. Los proyectos eran divertido y la tarea no muy díficil. La tarea de leer eran la peor parte de la clase. Uno de mis partes favoritos de este año fue cuándo un toro perseguío a la clase. Nosotros aprendíamos español también. 
 - Wesley"

[node name="TextBox2" parent="CSGBox3D6" unique_id=1796092197 instance=ExtResource("6_ujtx7")]
