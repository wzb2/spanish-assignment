[layer_names]

3d_render/layer_2="Invisible To Self"
3d_physics/layer_1="Solid"
3d_physics/layer_2="Interact"
3d_physics/layer_15="Atmosphere Areas"

[physics]

3d/run_on_separate_thread=true
common/physics_ticks_per_second=120
common/physics_jitter_fix=0.0
3d/physics_engine="Jolt Physics"
jolt_physics_3d/simulation/position_steps=15
3d/solver/solver_iterations=20
common/physics_interpolation=true
jolt_physics_3d/simulation/areas_detect_static_bodies=true

[rendering]

rendering_device/pipeline_cache/enable=false
rendering_device/driver="d3d12"
rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/screen_space_aa=1
